{
  "name": "root",
  "version": "1.0.0",
  "description": "This is the root package json, used for running scripts.  Use npm start to run the project.",
  "scripts": {
    "start": "concurrently --kill-others-on-fail \"npm run server-dev\" \"npm run client\"",
    "dev": "concurrently --kill-others-on-fail \"npm run server-dev\" \"npm run client\"",
    "test": "npm --prefix frontend run test:cleanup",
    "server-prod": "dotnet run --project backend_v2_dotnet --configuration Release --no-launch-profile --urls http://0.0.0.0:5001",
    "server-dev": "dotnet watch --project backend_v2_dotnet",
    "server": "dotnet run --project backend_v2_dotnet",
    "client": "cd frontend && npm start"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^7.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
